{
  "name": "@drogamais/log-acessos",
  "version": "0.6.0",
  "description": "Log de acesso e auditoria dos portais Drogamais (log_acessos no pgDrogamais) — plugin Fastify e middleware Express.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./fastify": {
      "import": { "types": "./dist/fastify.d.ts", "default": "./dist/fastify.js" },
      "require": { "types": "./dist/fastify.d.cts", "default": "./dist/fastify.cjs" }
    },
    "./express": {
      "import": { "types": "./dist/express.d.ts", "default": "./dist/express.js" },
      "require": { "types": "./dist/express.d.cts", "default": "./dist/express.cjs" }
    }
  },
  "typesVersions": {
    "*": {
      "fastify": ["./dist/fastify.d.cts"],
      "express": ["./dist/express.d.cts"]
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsup": "8.3.5",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
